declare
  result jsonb;
begin

  perform set_config('app.user_email', p_email, true);

  select jsonb_agg(
    jsonb_build_object(
      'id', c.id,
      'name', c.name,
      'description', c.description,
      'image_url', c.image_url,
      'join_type', c.join_type,

      -- ✅ member count
      'member_count', (
        select count(*) 
        from community_members cm
        where cm.community_id = c.id
      ),

      -- ✅ pending flag
      'is_pending', exists (
        select 1 
        from community_join_requests r
        where r.community_id = c.id
        and r.user_email = p_email
      )
    )
  )
  into result
  from communities c
  where c.status = 'approved'

  -- ❌ remove joined communities ONLY
  and not exists (
    select 1 
    from community_members cm
    where cm.community_id = c.id
    and cm.user_email = p_email
  );

  return coalesce(result, '[]'::jsonb);

end;
