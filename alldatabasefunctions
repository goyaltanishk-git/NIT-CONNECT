DECLARE
  v_college text;
  v_interested_in public.gender_type; -- ✅ FIXED: Correct Type
  result JSONB;
BEGIN
  -- 1. Get current user's college and preference
  SELECT college, interested_in INTO v_college, v_interested_in
  FROM profiles WHERE email = p_email;

  -- 2. Fetch matching profiles
  SELECT jsonb_agg(
    to_jsonb(p) || jsonb_build_object(
      'age', EXTRACT(YEAR FROM age(current_date, p.date_of_birth)),
      'photos', (
        SELECT COALESCE(jsonb_agg(jsonb_build_object('url', ph.photo_url, 'order', ph.photo_order) ORDER BY ph.photo_order), '[]'::jsonb)
        FROM user_photos ph WHERE ph.user_email = p.email
      ),
      'interests', (
        SELECT COALESCE(jsonb_agg(i.interest), '[]'::jsonb)
        FROM user_interests i WHERE i.user_email = p.email
      )
    )
  ) INTO result
  FROM profiles p
  WHERE p.college = v_college       
  AND p.gender = v_interested_in    -- ✅ Now compares Enum to Enum (Safe)
  AND p.is_active = true
  AND p.email != p_email            
  AND NOT EXISTS (
    SELECT 1 FROM user_interactions ui 
    WHERE (ui.user_id = p_email AND ui.target_user_id = p.email) 
       OR (ui.target_user_id = p_email AND ui.user_id = p.email)
  )
  LIMIT p_limit OFFSET p_offset;

  RETURN COALESCE(result, '[]'::jsonb);
END;
