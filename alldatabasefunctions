 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
begin

  -- ✅ Only moderator can approve
  if not exists (
    select 1 from community_members
    where community_id = p_community_id
      and user_email = p_email
      and role = 'moderator'
  ) then
    raise exception 'Not authorized';
  end if;

  -- ✅ Add to members
  insert into community_members (
    community_id,
    user_email,
    role,
    status
  )
  values (
    p_community_id,
    p_target_email,
    'member',
    'approved'
  )
  on conflict (community_id, user_email) do nothing;

  -- ✅ Remove from requests
  delete from community_join_requests
  where community_id = p_community_id
    and user_email = p_target_email;

end;
