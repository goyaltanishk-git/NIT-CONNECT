 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  result JSONB;
BEGIN
  PERFORM set_config('app.user_email', p_email, true);

  SELECT jsonb_agg(
    jsonb_build_object(
      'id', ui.user_id,
      'user_id', ui.user_id,
      'target_user_id', ui.target_user_id,
      'interaction_type', ui.interaction_type,
      'created_at', ui.created_at,
      'profile', (
        SELECT 
          CASE WHEN prof.incognito_mode THEN
            -- 🕵️ INCOGNITO MODE: Mask details including HOMETOWN
            (to_jsonb(prof) - 'gender' - 'branch' - 'phone_number' - 'instagram_handle' - 'first_name' - 'last_name' - 'hometown') || jsonb_build_object(
              'full_name', 'Incognito User',
              'first_name', 'Incognito',
              'last_name', 'User',
              'branch', null,
              'gender', null,
              'hometown', null, -- 👈 Hiding Hometown
              'photos', jsonb_build_array(
                jsonb_build_object(
                  'photo_url', 'https://www.gravatar.com/avatar/00000000000000000000000000000000?d=mp&f=y', 
                  'photo_order', 0, 
                  'is_primary', true
                )
              ),
              'interests', (
                  SELECT COALESCE(jsonb_agg(i.interest), '[]'::jsonb)
                  FROM user_interests i WHERE i.user_email = prof.email
              )
            )
          ELSE
            -- ✅ NORMAL MODE: Show full details
            to_jsonb(prof) || jsonb_build_object(
              'full_name', trim(prof.first_name || ' ' || COALESCE(prof.last_name, '')),
              'photos', (
                  SELECT COALESCE(jsonb_agg(ph ORDER BY ph.photo_order), '[]'::jsonb)
                  FROM user_photos ph WHERE ph.user_email = prof.email
              ),
              'interests', (
                  SELECT COALESCE(jsonb_agg(i.interest), '[]'::jsonb)
                  FROM user_interests i WHERE i.user_email = prof.email
              )
            )
          END
        FROM profiles prof
        WHERE prof.email = ui.user_id
      )
    )
  ) INTO result
  FROM user_interactions ui
  WHERE ui.target_user_id = p_email 
  AND ui.interaction_type = 'like'
  
  -- Exclude people I have already Liked Back or Passed
  AND NOT EXISTS (
    SELECT 1 FROM user_interactions my_action
    WHERE my_action.user_id = p_email 
    AND my_action.target_user_id = ui.user_id
  );

  RETURN COALESCE(result, '[]'::jsonb);
END;
