 SET search_path TO 'public'
AS $function$
DECLARE
  v_profile JSONB;
  v_is_incognito BOOLEAN;
BEGIN
  -- Check if user is incognito
  SELECT incognito_mode INTO v_is_incognito FROM profiles WHERE email = p_email;

  SELECT 
    CASE WHEN v_is_incognito THEN
      -- ✅ If Incognito: Remove 'gender' and 'branch' from the profile object
      (to_jsonb(p) - 'gender' - 'branch') 
    ELSE
      -- If Normal: Return everything
      to_jsonb(p)
    END 
    || jsonb_build_object(
      'age', EXTRACT(YEAR FROM age(current_date, p.date_of_birth)),
      
      -- Handle Name Hiding
      'full_name', CASE WHEN v_is_incognito THEN 'Incognito User' ELSE p.first_name || ' ' || COALESCE(p.last_name, '') END,
      
      -- Handle Photo Hiding
      'photos', CASE WHEN v_is_incognito THEN
        jsonb_build_array(jsonb_build_object('url', 'https://www.gravatar.com/avatar/00000000000000000000000000000000?d=mp&f=y', 'order', 0))
      ELSE
        (SELECT COALESCE(jsonb_agg(jsonb_build_object('url', ph.photo_url, 'order', ph.photo_order) ORDER BY ph.photo_order), '[]'::jsonb)
        FROM user_photos ph WHERE ph.user_email = p.email)
      END,
      
      'interests', (
        SELECT COALESCE(jsonb_agg(i.interest), '[]'::jsonb)
        FROM user_interests i WHERE i.user_email = p.email
      )
    ) INTO v_profile
  FROM profiles p
  WHERE p.email = p_email;

  RETURN v_profile;
END;
