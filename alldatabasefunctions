 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
BEGIN
  -- 1. Wipe the old, broken photo records for this user
  DELETE FROM public.user_photos WHERE user_email = p_email;

  -- 2. Insert the exact truth straight from the storage bucket
  IF jsonb_array_length(p_photos) > 0 THEN
    INSERT INTO public.user_photos (user_email, photo_url, photo_order, is_primary)
    SELECT
      p_email,
      (x->>'photo_url'),
      (x->>'photo_order')::int,
      (x->>'is_primary')::boolean
    FROM jsonb_array_elements(p_photos) t(x);
  END IF;
END;
