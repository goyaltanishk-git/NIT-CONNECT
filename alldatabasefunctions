 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
  secure_email text;
BEGIN
  -- 🔒 SECURITY CHECK: Get email directly from the secure token
  secure_email := auth.jwt() ->> 'email';

  -- If no token exists (user not logged in), stop immediately
  IF secure_email IS NULL THEN
    RAISE EXCEPTION 'Not authenticated';
  END IF;

  -- Insert using the SECURE email, ignoring anything else
  INSERT INTO user_interactions (user_id, target_user_id, interaction_type)
  VALUES (secure_email, target_email, 'like');
END;
