                                                                                                                                                                                                            |
| public      | process_interaction                 | p_actor_email text, p_target_user_id text, p_action text                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           | jsonb                                                                                                                                                                                                                                                                                                                                                                                      | CREATE OR REPLACE FUNCTION public.process_interaction(p_actor_email text, p_target_user_id text, p_action text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_existing_interaction text;
BEGIN
  -- 1. Explicitly set the session variable so triggers (like match creation) work
  PERFORM set_config('app.user_email', p_actor_email, true);

  -- 2. Check if YOU have already interacted with THEM
  SELECT interaction_type INTO v_existing_interaction
  FROM user_interactions
  WHERE user_id = p_actor_email
    AND target_user_id = p_target_user_id;

  IF v_existing_interaction IS NOT NULL THEN
    RETURN jsonb_build_object('success', true, 'status', 'already_exists');
  END IF;

  -- 3. Insert the new interaction
  INSERT INTO user_interactions (user_id, target_user_id, interaction_type)
  VALUES (p_actor_email, p_target_user_id, p_action);

  RETURN jsonb_build_object('success', true, 'action', p_action);

EXCEPTION WHEN OTHERS THEN
  RETURN jsonb_build_object('success', false, 'error', SQLERRM);
END;
