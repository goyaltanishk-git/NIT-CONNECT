 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
    -- Check User 1
    IF NOT EXISTS (SELECT 1 FROM profiles WHERE email = NEW.user1_id AND is_active = true) THEN
        RAISE EXCEPTION 'User 1 is not an active account.';
    END IF;

    -- Check User 2
    IF NOT EXISTS (SELECT 1 FROM profiles WHERE email = NEW.user2_id AND is_active = true) THEN
        RAISE EXCEPTION 'User 2 is not an active account.';
    END IF;

    RETURN NEW;
END;
