 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
  DELETE FROM public.messages
  WHERE ctid IN (
    SELECT ctid
    FROM public.messages
    WHERE
      LEAST(sender, reciever) = LEAST(NEW.sender, NEW.reciever)
      AND
      GREATEST(sender, reciever) = GREATEST(NEW.sender, NEW.reciever)
    ORDER BY created_at DESC
    OFFSET 50
  );

  RETURN NEW;
END;
