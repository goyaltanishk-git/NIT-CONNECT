| public      | randomize_profiles_order            |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    | void                                                                                                                                                                                                                                                                                                                                                                                       | CREATE OR REPLACE FUNCTION public.randomize_profiles_order()
 RETURNS void
 LANGUAGE plpgsql
AS $function$
BEGIN
  UPDATE profiles
  SET shuffle_order = s.rn
  FROM (
    SELECT email, ROW_NUMBER() OVER (ORDER BY RANDOM()) AS rn
    FROM profiles
  ) s
  WHERE profiles.email = s.email;
END;
