 RETURNS void
 LANGUAGE plpgsql
AS $function$
declare
  v_email text;
  v_comm uuid;
  v_user text;
begin

  v_email := auth.jwt()->>'email';

  -- get request
  select community_id, user_email into v_comm, v_user
  from community_join_requests
  where id = p_request_id;

  -- check moderator
  if not exists (
    select 1 from community_members
    where community_id = v_comm
    and user_email = v_email
    and role = 'moderator'
  ) then
    raise exception 'NOT_MODERATOR';
  end if;

  insert into community_members (community_id, user_email)
  values (v_comm, v_user);

  update community_join_requests
  set status = 'approved'
  where id = p_request_id;

end;
