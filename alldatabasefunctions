 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
declare
  v_user_email text;
  v_existing_interaction text;
begin
  -- 1. Get the current user's email securely from the session or JWT
  v_user_email := auth.jwt() ->> 'email';
  
  -- Fallback if using custom auth flow without standard JWT
  if v_user_email is null then
    v_user_email := current_setting('app.user_email', true);
  end if;

  if v_user_email is null then
    return jsonb_build_object('success', false, 'error', 'User not authenticated');
  end if;

  -- 2. Explicitly set the session variable for any triggers (like match creation)
  perform set_config('app.user_email', v_user_email, true);

  -- 3. Check if an interaction already exists to prevent duplicates
  select interaction_type into v_existing_interaction
  from user_interactions
  where user_id = v_user_email
    and target_user_id = p_target_user_id;

  if v_existing_interaction is not null then
    -- Optional: Update existing interaction if they changed their mind?
    -- For now, we return success assuming it's already done.
    return jsonb_build_object('success', true, 'status', 'already_exists');
  end if;

  -- 4. Insert the new interaction (Like or Pass)
  insert into user_interactions (user_id, target_user_id, interaction_type)
  values (v_user_email, p_target_user_id, p_action);

  -- 5. Return success
  return jsonb_build_object('success', true, 'action', p_action);

exception when others then
  return jsonb_build_object('success', false, 'error', SQLERRM);
end;
