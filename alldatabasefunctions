 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
    -- Check if the person SENDING the like is active
    IF NOT EXISTS (SELECT 1 FROM profiles WHERE email = NEW.user_id AND is_active = true) THEN
        RAISE EXCEPTION 'Sender account is deactivated.';
    END IF;

    -- Check if the person RECEIVING the like is active
    IF NOT EXISTS (SELECT 1 FROM profiles WHERE email = NEW.target_user_id AND is_active = true) THEN
        RAISE EXCEPTION 'Target account is deactivated.';
    END IF;

    RETURN NEW;
END;
