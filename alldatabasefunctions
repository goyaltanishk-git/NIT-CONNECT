 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  result JSONB;
BEGIN
  PERFORM set_config('app.user_email', p_email, true);

  WITH conversation_data AS (
    SELECT
      CASE WHEN m.user1_id = p_email THEN m.user2_id ELSE m.user1_id END as match_id,
      (
        SELECT jsonb_build_object(
          'email', prof.email,
          'first_name', CASE WHEN prof.incognito_mode THEN 'Incognito' ELSE prof.first_name END,
          'last_name', CASE WHEN prof.incognito_mode THEN 'User' ELSE prof.last_name END,
          'photos', CASE WHEN prof.incognito_mode THEN 
              jsonb_build_array(jsonb_build_object('photo_url', 'https://www.gravatar.com/avatar/00000000000000000000000000000000?d=mp&f=y', 'photo_order', 0, 'is_primary', true))
            ELSE 
              (SELECT COALESCE(jsonb_agg(ph ORDER BY ph.photo_order), '[]'::jsonb) FROM user_photos ph WHERE ph.user_email = prof.email)
            END,
          'incognito_mode', prof.incognito_mode,
          'last_active_at', prof.last_active_at,
          'bio', prof.bio,
          'college', prof.college,
          'year_of_study', prof.year_of_study,
          'branch', CASE WHEN prof.incognito_mode THEN NULL ELSE prof.branch END,
          'hometown', prof.hometown
        )
        FROM profiles prof
        WHERE prof.email = (CASE WHEN m.user1_id = p_email THEN m.user2_id ELSE m.user1_id END)
      ) as user_data,
      (
        SELECT to_jsonb(msg)
        FROM messages msg
        WHERE (msg.sender = p_email AND msg.reciever = (CASE WHEN m.user1_id = p_email THEN m.user2_id ELSE m.user1_id END))
           OR (msg.sender = (CASE WHEN m.user1_id = p_email THEN m.user2_id ELSE m.user1_id END) AND msg.reciever = p_email)
        ORDER BY msg.created_at DESC
        LIMIT 1
      ) as last_message,
      (
        SELECT count(*)
        FROM messages msg
        WHERE msg.reciever = p_email
          AND msg.sender = (CASE WHEN m.user1_id = p_email THEN m.user2_id ELSE m.user1_id END)
          AND msg.is_read = false
      ) as unread_count
    FROM matches m
    WHERE (m.user1_id = p_email OR m.user2_id = p_email)
    AND m.is_active = true  -- 👈 THIS LINE ENSURES HIDDEN MATCHES DON'T SHOW
  )
  SELECT jsonb_agg(
    jsonb_build_object(
      'match_id', match_id,
      'user', user_data,
      'lastMessage', last_message,
      'unreadCount', unread_count
    )
    ORDER BY (last_message->>'created_at') DESC NULLS LAST
  ) INTO result
  FROM conversation_data;

  RETURN COALESCE(result, '[]'::jsonb);
END;
