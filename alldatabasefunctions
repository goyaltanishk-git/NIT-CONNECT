 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
    -- Check if the user is deactivating their account
    IF (OLD.is_active = true AND NEW.is_active = false) THEN
        -- Delete all matches involving this email
        DELETE FROM matches 
        WHERE user1_id = NEW.email OR user2_id = NEW.email;
    END IF;
    RETURN NEW;
END;
