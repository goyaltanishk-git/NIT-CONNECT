| public      | join_community                      | p_community_id uuid                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                | text                                                                                                                                                                                                                                                                                                                                                                                       | CREATE OR REPLACE FUNCTION public.join_community(p_community_id uuid)
 RETURNS text
 LANGUAGE plpgsql
AS $function$
declare
  v_email text;
  v_count int;
  v_join_type text;
begin

  v_email := auth.jwt()->>'email';

  -- limit 5 communities
  select count(*) into v_count
  from community_members
  where user_email = v_email
  and status = 'approved';

  if v_count >= 5 then
    return 'LIMIT_REACHED';
  end if;

  -- get join type
  select join_type into v_join_type
  from communities where id = p_community_id;

  if v_join_type = 'open' then
    insert into community_members (community_id, user_email)
    values (p_community_id, v_email);

    return 'JOINED';

  else
    insert into community_join_requests (community_id, user_email)
    values (p_community_id, v_email);

    return 'REQUEST_SENT';
  end if;

end;
